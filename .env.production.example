# ==============================================================================
# TEMU PULANG — PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# Copy this file to .env on the Windows 11 shop host PC before go-live.
# Never commit real passwords or APP_KEY values to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Identity & Environment
# Run `php artisan key:generate` after copying this file to populate APP_KEY.
# Replace APP_URL with the fixed LAN IPv4 address of the Windows 11 host PC.
# ------------------------------------------------------------------------------
APP_NAME="Temu Pulang"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://192.168.1.100
APP_TIMEZONE=Asia/Jakarta

# ------------------------------------------------------------------------------
# 2. Localization Defaults (Indonesian Primary, English Secondary)
# ------------------------------------------------------------------------------
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# ------------------------------------------------------------------------------
# 3. Maintenance & Password Hashing
# ------------------------------------------------------------------------------
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# 4. Logging Configuration
# Use warning (or info) in production; avoid debug to prevent verbose disk logs.
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ------------------------------------------------------------------------------
# 5. Local MySQL / MariaDB Database Connection
# Keep MySQL bound strictly to 127.0.0.1 (never expose port 3306 to the LAN).
# Set a strong local database password in .env on the host machine.
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=temu_pulang
DB_USERNAME=temupulang_user
DB_PASSWORD=

# ------------------------------------------------------------------------------
# 6. Session Management
# 720 minutes (12 hours) covers a full F&B cashier shift without mid-shift expiry.
# Keep SESSION_SECURE_COOKIE=false when serving over local LAN HTTP without TLS.
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# ------------------------------------------------------------------------------
# 7. Cache, Queue & Filesystem Drivers
# Persistent database drivers ensure state survives across Apache requests.
# ------------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ------------------------------------------------------------------------------
# 8. Frontend Asset Bundling
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
